{
  "name": "assessment",
  "version": "1.0.0",
  "description": "Playwright Assessment",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --ext .ts --cache",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "test": "npm run lint && npx playwright test",
    "test:fix": "npm run lint:fix && npm run format && npx playwright test",
    "test:headed": "npx playwright test tests/features/assessment.spec.ts --headed --project=chromium",
    "test:report": "npx playwright show-report",
    "clean:reports": "rm -rf test-results/allure-results && rm -rf test-results/allure-report",
    "reports": "allure generate --single-file test-results/allure-results -o test-results/allure-report --clean",
    "test:allure": "npm run clean:reports && npx playwright test; npm run reports",
    "open-reports": "allure open test-results/allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "dotenv": "^18.0.5"
  }
}
